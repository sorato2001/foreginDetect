# Environment Configuration for Multi-Camera Event Recording System
# 
# Copy this file to .env and customize for your Windows environment.
# On Windows, environment variables can override config.yaml settings.
#
# Usage:
#   1. Rename .env-example to .env
#   2. Uncomment and fill in values as needed
#
# NOTE: These settings override values in cameras.yaml if set!

# ============================================================
# Paths (use forward slashes / or double backslashes \\)
# ============================================================

# Base cache directory for rolling buffer segments
# CACHE_DIR=./data/cache
# CACHE_DIR=C:/Users/YourName/Documents/multicam/cache
# CACHE_DIR=C:\\Users\\YourName\\Documents\\multicam\\cache

# Base video directory for final event videos
# VIDEO_DIR=./data/video
# VIDEO_DIR=C:/data/video

# Database path
# DB_PATH=./data/db/events.db

# Log directory
# LOG_DIR=./data/logs

# ============================================================
# FFmpeg
# ============================================================

# Full path to ffmpeg executable
# Uncomment if ffmpeg is not in PATH or you want to specify explicit path
# FFMPEG_PATH=C:/Program Files/ffmpeg/bin/ffmpeg.exe
# FFMPEG_PATH=C:\\Program Files\\ffmpeg\\bin\\ffmpeg.exe

# ============================================================
# System Settings
# ============================================================

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# How often to check for finalization (seconds)
SCHEDULER_INTERVAL=1.0

# How often to clean old cache files (seconds)
CLEANUP_INTERVAL=30.0

# ============================================================
# API Settings (if enabled in cameras.yaml)
# ============================================================

# REST API host
API_HOST=0.0.0.0

# REST API port
API_PORT=8000

# ============================================================
# Windows-Specific Settings
# ============================================================

# Set to true to use Windows Event Log (optional, requires pywin32)
# USE_WINDOWS_EVENT_LOG=false

# Disable ANSI colors in console output (set to true if colors look wrong)
# NO_COLOR=false

# ============================================================
# Example Complete Configuration
# ============================================================
#
# After uncommenting, your .env file might look like:
#
# CACHE_DIR=C:/data/multicam/cache
# VIDEO_DIR=C:/data/multicam/video
# FFMPEG_PATH=C:/Program Files/ffmpeg/bin/ffmpeg.exe
# LOG_LEVEL=INFO
# API_HOST=127.0.0.1
# API_PORT=8000
#
# ============================================================
